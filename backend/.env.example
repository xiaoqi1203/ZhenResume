# ---- LLM ----
# 留空则后端自动进入 mock 模式：全链路仍可跑通，报告由规则引擎生成。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# 计价（元 / 百万 token），用于 workflow_steps.cost 与成本看板
LLM_PRICE_INPUT_PER_M=2.0
LLM_PRICE_OUTPUT_PER_M=8.0

# ---- 存储 ----
# 这两项**默认不要设置**：不设置时程序按自身文件位置推导出绝对路径
# （<backend>/data/zhenresume.db 与 <backend>/data/uploads），与启动目录无关。
#
# 之所以不建议写相对路径（如 ./data/zhenresume.db）：那样数据库落在哪取决于进程的工作目录，
# 换一个启动方式（PyCharm 运行配置 / 命令行 / 服务）就可能建出第二个空库，
# 表面上像是"数据丢了"，实际是连到了不同的文件。
#
# 升级到 PostgreSQL + pgvector 时取消下面这行注释并填入连接串（DDL 同构）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/zhenresume
# 需要把上传文件放到别处时再显式指定绝对路径：
# UPLOAD_DIR=/var/lib/zhenresume/uploads

# ---- PDF 导出（可选）----
# 简历编辑器导出 PDF 依赖 LibreOffice Kit，需要 node 与 cli 两个绝对路径。
# 刻意留空而不是内置默认值：产品不应该硬编码运行环境的安装位置。
# 留空时导出 PDF 会返回 503 PDF_UNAVAILABLE，前端会引导用户改用 DOCX 或浏览器打印。
LIBREOFFICE_NODE=
LIBREOFFICE_CLI=
PDF_TIMEOUT_S=120

# ---- 业务 ----
FREE_QUOTA=3
FRONTEND_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
