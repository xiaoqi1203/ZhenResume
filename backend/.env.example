# ---- LLM（多供应商降级链）----
# 按 LLM_PROVIDERS 的顺序逐层尝试；同一层内按「模型阶梯」降级；
# 每一层内部再做 LLM_MAX_RETRIES 次指数退避；全部失败才回落到该 Agent 的规则引擎实现
# （对应步骤标记 degraded，原因写进 workflow_steps.notes，不静默）。
# 所有供应商都走 OpenAI 兼容协议：POST {base_url}/chat/completions + response_format=json_object。
# 所有 Key 留空 = mock 模式：全链路仍可跑通，报告由规则引擎生成。
LLM_PROVIDERS=aliyun,deepseek
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# 第一层：阿里云百炼（DashScope）OpenAI 兼容端点
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 2026-10-20：对话模型统一为 DeepSeek 系 —— 阿里云只保留 deepseek-v4.1-flash 一个模型，
# 原 Qwen / Kimi 阶梯（qwen3.8-max、qwen3.7-flash、qwen3.8-2.4t-a95b、kimi-k3…）全部移除。
# ⚠️ 不带日期的 deepseek-v4.1-flash 实测 403（免费额度耗尽）；日期快照 -1017 可用。
#    该型号只在阿里云百炼提供，DeepSeek 官方 API 没有它（官方只有 deepseek-flash / deepseek-v4-pro）。
ALIYUN_MODEL=deepseek-v4.1-flash-1017
# 同层模型阶梯（逗号分隔，按序降级）；留空则只用 ALIYUN_MODEL。
# 现在留空 = 该模型失败就直接落到第二层 DeepSeek 官方。
ALIYUN_MODEL_FALLBACKS=
# 额外请求体（JSON 对象字符串），原样并入请求。
# ⚠️ 默认值 {"enable_thinking": false} 是**实测结论**：真实 parse 节点上，
#    qwen3.8-max 开思考 60.1s / 2483 输出 token；关思考 9.5s / 404 token
#    （快 6.3×、省 77% 成本），而解析结果完全一致。8 个节点串行时，
#    这是"8 分钟一份报告"与"1 分钟一份报告"的差别 —— 直接决定 60 秒验收项能不能过。
#    deepseek-v4.1-flash-1017 实测也接受该参数。
ALIYUN_EXTRA_BODY={"enable_thinking": false}
# 按模型覆盖 extra_body（JSON）：{"模型名": {字段...}}。
# 原用途是给 qwen3.8-2.4t-a95b 强制 enable_thinking=true；该模型已移除，保持留空即可。
ALIYUN_MODEL_EXTRA_BODY=
ALIYUN_PRICE_INPUT_PER_M=0
ALIYUN_PRICE_OUTPUT_PER_M=0

# 第二层：DeepSeek 官方（兜底：整个阿里云层不可用时才走）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_MODEL_FALLBACKS=
DEEPSEEK_EXTRA_BODY=
DEEPSEEK_PRICE_INPUT_PER_M=0
DEEPSEEK_PRICE_OUTPUT_PER_M=0

# 计价（元 / 百万 token），用于 workflow_steps.cost 与成本看板。
# 上面各层的 *_PRICE_* 为 0 时就用这两个值；配了则用各层自己的单价
# （不同模型价差很大，不分开算，"单份 ≤ 0.5 元"这个验收数就是错的）。
LLM_PRICE_INPUT_PER_M=2.0
LLM_PRICE_OUTPUT_PER_M=8.0

# ---- 工作流编排（LangGraph 1.2）----
# legacy    = 手写状态机（workflow/engine.py），行为基线
# langgraph = LangGraph 图（workflow/graph.py）：断点续跑 / 三路并行 / 节点级重试
# 两者共用同一批 services/* 与 agents/*，切换只改变"谁来编排"，业务语义完全一致
# （已用 174 项契约自检 + 两引擎逐字段比对验证）
WORKFLOW_ENGINE=legacy
# 三路并行：ats / impact / risk 在同一 superstep 并发（live 模式可省约 2 个节点延迟）
WORKFLOW_PARALLEL=false
# 质检回环次数上限；0 = 关闭（保持现状语义）
WORKFLOW_REWORK_MAX=0
# checkpoint：off = 不落盘（功能可用、崩溃需重跑）；sqlite = 单机可续跑；postgres = 生产
LANGGRAPH_CHECKPOINT=off
LANGGRAPH_CHECKPOINT_URL=
# exit（最快，崩溃无法中间恢复）| async（推荐）| sync（最稳最慢）
LANGGRAPH_DURABILITY=async
# 服务重启后，卡在 running 且心跳超过该秒数的任务会从断点续跑
ZOMBIE_TASK_TIMEOUT_S=300
# 同时在飞的 LLM 调用数（并行 / 批量时生效）
LLM_MAX_CONCURRENCY=4

# ---- 执行模型（谁把工作流跑起来）----
# inline = FastAPI BackgroundTasks（进程内）。scripts/verify.py 依赖"请求返回前跑完"这个语义。
# celery = 投递到 Redis，由独立 worker 执行（生产）。web 进程不再被长任务占住，重启不丢任务。
WORKFLOW_EXECUTOR=inline
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_TIME_LIMIT_S=900
CELERY_TASK_SOFT_TIME_LIMIT_S=840

# ---- 存储 ----
# 这两项**默认不要设置**：不设置时程序按自身文件位置推导出绝对路径
# （<backend>/data/zhenresume.db 与 <backend>/data/uploads），与启动目录无关。
#
# 之所以不建议写相对路径（如 ./data/zhenresume.db）：那样数据库落在哪取决于进程的工作目录，
# 换一个启动方式（PyCharm 运行配置 / 命令行 / 服务）就可能建出第二个空库，
# 表面上像是"数据丢了"，实际是连到了不同的文件。
#
# 升级到 PostgreSQL + pgvector 时取消下面这行注释并填入连接串（DDL 同构）：
# 注意驱动用 psycopg3：postgresql+psycopg://（不是 postgresql://，也不是 psycopg2）
# DATABASE_URL=postgresql+psycopg://zhenresume:密码@127.0.0.1:5432/zhenresume
# 需要把上传文件放到别处时再显式指定绝对路径：
# UPLOAD_DIR=/var/lib/zhenresume/uploads

# ---- RAG / 向量检索 ----
# EMBEDDING_PROVIDER=hash  = 本地确定性哈希向量（默认）：零依赖、可离线、结果可复现，
#                            但不是语义向量（"性能优化" 检索不到 "优化慢查询"）。
# EMBEDDING_PROVIDER=http  = 调 OpenAI 兼容的 /embeddings（如阿里云百炼 text-embedding-v4），
#                            是真实语义向量；未配 EMBEDDING_API_KEY/BASE_URL 时自动复用 aliyun 层。
#
# ⚠️ 从 hash 切到 http 时必须重建索引：python -m scripts.seed_knowledge --force
# 维度不匹配、或"查询模型 ≠ 库内模型"时，后端会**明确报错/降级为纯词面检索并打警告**，
# 不会静默返回全 0 分。
#
# 2026-10-22 实测：本地 Ollama 的 mxbai-embed-large（1024 维）在**语义检索质量上明显强于**
# 阿里云 qwen3.7-text-embedding-flash。同一批 32 例夹具、同一套 gold：
#     阿里云 qwen3.7：前 3 条命中 gold 2.06 条（68.8%）
#     本地 mxbai     ：前 3 条命中 gold 3.00 条（100.0%）
# 且换到 mxbai 后，BM25 重排从"提升 +12.5pp"变成"下降 −33.3pp"——
# 说明**向量层变强之后，词面重排就成了噪声**。这两个结论都依赖具体模型，不可跨模型套用。
# 若要用本地 Ollama：
#     1) ollama pull mxbai-embed-large
#     2) 把下面的 BASE_URL/API_KEY/MODEL 指到 http://127.0.0.1:11434/v1
#     3) EMBEDDING_DIM 改成 1024
#     4) python -m scripts.seed_knowledge --force && python -m scripts.seed_web_corpus --force
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 回退层（可选，例：本地 Ollama）。**必须与主层同维度**，否则直接报错。
# 注意：运行时回退只保证"不空手而归"（不同模型 → 自动降级为纯词面检索），
# 想让回退层真正参与向量检索，要把它设成主层并重建索引。
EMBEDDING_FALLBACK_BASE_URL=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=60
RAG_TOP_K=5

# ---- 文件抽取与本地 OCR（可选，**不需要任何外部 API/Key**）----
# 图片简历（PNG/JPG）与扫描版 PDF 走本机 OCR 引擎；没有 Key、没有 base_url，
# 装了什么引擎就用什么（pip install rapidocr-onnxruntime 或 apt 装 tesseract + pytesseract）。
# 装完用 `python -m scripts.check_ocr` 自检。
OCR_ENABLED=true
# auto = rapidocr → tesseract 取第一个可用的；也可写死 rapidocr / tesseract / off
OCR_BACKEND=auto
# tesseract 语言；chi_sim 缺失时会自动降级到已安装的语言子集（并把降级写进 extract_note）
OCR_LANG=chi_sim+eng
# rapidocr 置信度阈值：低于它的文本块丢弃（0.5 是官方默认口径）
OCR_MIN_SCORE=0.5
# 识别前等比缩放的最长边（0 = 不缩放）；手机拍的大图缩放后更快也更准
OCR_MAX_SIDE=2200
# 扫描版 PDF 最多 OCR 多少页（挡住几百页的扫描件），以及无内嵌位图时的整页渲染 DPI
OCR_MAX_PAGES=10
OCR_RENDER_DPI=200
# PDF 文本层短于这个字数就当作扫描件，触发 OCR 回退
OCR_TEXT_LAYER_MIN_CHARS=24
# tesseract 可执行文件路径；留空则从 PATH 找（Windows 常需要显式指定）
TESSERACT_CMD=

# ---- PDF 导出（可选）----
# 简历编辑器导出 PDF 依赖 LibreOffice Kit，需要 node 与 cli 两个绝对路径。
# 刻意留空而不是内置默认值：产品不应该硬编码运行环境的安装位置。
# 留空时导出 PDF 会返回 503 PDF_UNAVAILABLE，前端会引导用户改用 DOCX 或浏览器打印。
LIBREOFFICE_NODE=
LIBREOFFICE_CLI=
PDF_TIMEOUT_S=120

# ---- 业务 ----
FREE_QUOTA=3
FRONTEND_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---- 账号与鉴权 ----
# JWT 签名密钥：**生产必须配置**（任意 32+ 位随机字符串，例如 `python -c "import secrets;print(secrets.token_urlsafe(48))"`）。
# 留空时服务仍能启动，但会使用不安全的开发默认密钥并在日志里告警。
AUTH_SECRET=
# access token 有效期（分钟），默认 7 天。MVP 不做 refresh token。
JWT_EXPIRE_MINUTES=10080
# true = 只认登录态，匿名 X-Device-Id 一律 401（准备强制登录时再打开）
AUTH_REQUIRED=false
# 管理员白名单（逗号分隔，命中即在该账号登录/注册时把 role 提升为 admin）。
# 不配置也能用：账号建好后执行 `python -m scripts.grant_admin --email <邮箱>` 显式授权。
# 推荐用 ADMIN_PHONES（手机号经过短信验证）；ADMIN_EMAILS 适合本机/内网部署，
# 因为当前注册流程**没有验证邮箱归属**，公网部署请优先用脚本或手机号白名单。
ADMIN_EMAILS=
ADMIN_PHONES=
# 短信开发模式：true 时不真发短信，验证码固定为 SMS_DEV_CODE 并在 /auth/sms-code 响应里返回。
# ⚠️ 上线必须改成 false；否则任何人请求接口就能拿到验证码。
SMS_DEV_MODE=true
SMS_DEV_CODE=123456