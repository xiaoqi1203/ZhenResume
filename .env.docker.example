# 复制为根目录 .env 后按需修改：copy .env.docker.example .env
#
# ⚠️ 这个 .env 只给 docker-compose.yml 做变量替换，不会被后端读取！
#    后端自己的配置在 backend/.env（compose 已把它挂进容器，文件存在就生效）。
#
# 全部留空也能跑：后端进 mock 模式（规则引擎生成报告），全链路可用。

# ---- 后端 LLM（填了才切真实模型）----
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 宿主机端口（被占用时改这里）----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- 构建期依赖源（国内网络强烈建议填写，否则可能卡在下载）----
# 后端 pip：留空 = 官方 pypi.org
PIP_INDEX_URL=
# 前端 npm（corepack 拉 pnpm 与 pnpm 拉依赖都走它）：留空 = 官方 registry.npmjs.org
NPM_REGISTRY=

# ---- 前端要访问的后端地址：构建期内联，改完必须 --build 重新构建 ----
# 默认 http://localhost:8000 适用于"浏览器就在这台宿主机上"的场景。
# 部署到别的机器时改成宿主机的实际地址，例如 http://192.168.1.10:8000。
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- CORS 与分享链接 ----
# 浏览器地址栏里 127.0.0.1 与 localhost 算**两个**来源，所以默认两个都写。
# 换成真实域名/机器 IP 时，把下面的值改成浏览器实际访问前端的地址。
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# ---- PDF 导出（可选）----
# 后端镜像默认不装 LibreOffice，留空即可：导出 PDF 返回 503，前端引导改用 DOCX。
# 只跑 Dockerfile 默认镜像时，填了这两个路径也没用——见 backend/Dockerfile 末尾注释。
LIBREOFFICE_NODE=
LIBREOFFICE_CLI=
