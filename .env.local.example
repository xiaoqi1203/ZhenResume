# 全栈本机 Docker 部署变量（配合 docker-compose.local.yml）
#
# 用法：
#   Copy-Item .env.local.example .env.local
#   # 填好下面的密码（两个都要改，别用示例值）
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d --build
#
# ⚠️ 本文件含密码，已在 .gitignore 中排除，不要提交。

# ---- PostgreSQL（容器内，卷 zhenresume-pgdata 持久化）----
POSTGRES_USER=zhenresume
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=zhenresume
# 宿主机映射端口（只绑 127.0.0.1）。与既有 PG 冲突时改这里。
POSTGRES_HOST_PORT=5432

# ---- Redis（容器内，卷 zhenresume-redisdata 持久化）----
REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6379

# ---- 端口与「浏览器可见」地址 ----
# 这三项必须互相一致，否则前端会报 CORS 或接口连不上：
#   浏览器打开 FRONTEND 端口 → 页面内联的 PUBLIC_API_BASE → 后端放行 CORS_ORIGINS
API_PORT=8000
FRONTEND_PORT=3000
PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# ---- 工作流 ----
# celery：请求立刻返回 202，工作流交给 worker（推荐；长任务不会顶住 HTTP）
# inline：在请求内跑完（scripts/verify.py 依赖这个语义，仅调试用）
WORKFLOW_EXECUTOR=celery
WORKFLOW_ENGINE=langgraph
WORKFLOW_PARALLEL=true
HR_SCREENING=true
HR_BATCH_CONCURRENCY=50
# checkpoint 存 PG（容器里用 sqlite 文件会随容器重建丢失）
LANGGRAPH_CHECKPOINT=postgres

# ---- 构建加速（可选）----
# 国内直连 PyPI 很慢；留空则用 Dockerfile 默认行为
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=
# 离线兜底：先 pip download -d backend/wheels，再填 wheels
PIP_FIND_LINKS=
NPM_REGISTRY=https://registry.npmmirror.com

# ---- 可选：宿主机 Ollama 作为 embedding 回退层 ----
# 注意：本机 Docker 场景下这是"容器 -> 宿主机"，必须用 host.docker.internal
EMBEDDING_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1

# ---- 本地 OCR 引擎（图片简历 / 扫描版 PDF；零外部 API）----
# rapidocr（默认，约 70MB，中文好）| tesseract（更轻，中文略逊）| none（这两类输入会降级）
# ⚠️ 改这里之后必须重新 build 后端镜像：up -d --build api worker
INSTALL_OCR=rapidocr