# 中间件 compose 的变量（复制成 .env 后改密码）
#   cp deploy/infra/.env.example deploy/infra/.env
# 这里的密码必须与 backend/.env 里 DATABASE_URL / CELERY_* 中写的一致。

POSTGRES_USER=zhenresume
POSTGRES_PASSWORD=改成一个强密码
POSTGRES_DB=zhenresume
POSTGRES_PORT=5432

REDIS_PASSWORD=换成另一个强密码
REDIS_PORT=6379

API_PORT=8000

# 容器内的 api/worker 要连宿主机的 Ollama 时用这个（compose 里已加 host-gateway）
EMBEDDING_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
